name "hentai"
version "1.0"
author "yukiisen"

// --- templates ---
tmpl BUILD "bash {}"

// --- commands ---

// run STRING (no template) + args + optargs + all three requirement kinds
cmd hello {
    desc "Say hello"
    run "echo hello"
    args 0
    optargs 0
    requires env "USER"
    requires bin "echo"
    requires file ".env"
}

// shortcut with run, no template
cmd pwd : run "pwd"

// shortcut with exec, multi-arg
cmd ls : exec "ls", "-la"

// run IDENT STRING (template reference) + nested subcommands
cmd build {
    desc "Build the project"
    run BUILD "scripts/build.sh"
    optargs 2
    requires bin "bash"
    requires file "Makefile"

    cmd clean {
        desc "Clean artifacts"
        exec "rm", "-rf", "build"
    }
}

alias h hello
alias p pwd
alias c build.clean
