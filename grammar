program -> template* command* alias*;
program -> (program | meta)*;

meta -> ("name" | "author" | "version") STRING;

template -> "tmpl" IDENT STRING;

command -> "cmd" IDENT (
    ("{" description? (shell | spawn)? argc? optionalargc? requirement* command* "}") 
    | 
    (":" (shell | spawn))
);

description -> "desc" STRING;
shell -> "run" IDENT? STRING;
spawn -> "exec" STRING(,STRING)*;
argc -> "args" NUMBER;
optionalargc -> "optargs" NUMBER;
requirement -> "requires" ("file" | "env" | "bin") STRING;

alias -> "alias" IDENT ident;
ident -> IDENT("."ident)*;
